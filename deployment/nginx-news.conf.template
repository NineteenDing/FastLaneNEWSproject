# Include this inside nginx http {}. Replace CERT_ROOT with e.g. C:/nginx/conf/certs/20261025.
# Keep all existing app/admin server blocks and upstreams intact.
server {
    listen 80;
    server_name news.fastlane.chat;
    return 301 https://news.fastlane.chat$request_uri;
}
server {
    listen 443 ssl;
    server_name news.fastlane.chat;
    ssl_certificate CERT_ROOT/news.fastlane.chat_bundle.crt;
    ssl_certificate_key CERT_ROOT/news.fastlane.chat.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8m;
    location / {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}
