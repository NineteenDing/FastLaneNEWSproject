{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry",
    "site",
    "modules/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && tsc -p modules && tsc -p scripts/studio.tsconfig.json && npm run typecheck -w @aihot/web",
    "local:check": "node scripts/studio-local.ts check",
    "local:import-news": "node modules/studio/scripts/import-news.ts",
    "local:rsshub-check": "node modules/studio/scripts/check-rsshub.ts",
    "local:rsshub-install": "node modules/studio/scripts/install-rsshub.ts",
    "local:start": "node scripts/studio-local.ts start",
    "local:status": "node scripts/studio-local.ts status",
    "local:resources": "node scripts/studio-local.ts resources",
    "local:stop": "node scripts/studio-local.ts stop",
    "local:test": "node scripts/studio-local.ts test",
    "test": "node --test-global-setup=tests/databases.ts --import ./tests/databases.ts --test --test-concurrency=2 --test-timeout=120000 \"tests/*.test.ts\" \"modules/*/tests/*.test.ts\"",
    "test:standalone": "node --import ./tests/standalone.ts --test --test-concurrency=6 --test-timeout=120000 \"tests/*.standalone.test.ts\" \"modules/*/tests/*.standalone.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
